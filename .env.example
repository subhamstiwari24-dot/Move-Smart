# ==============================================================================
# MoveSmart — Smart Mobility Platform Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT CONFIGURATION (Configure in Vercel or local .env)
# ------------------------------------------------------------------------------
# In Development:
VITE_API_BASE_URL=http://localhost:8080

# In Production (Set in Vercel Dashboard -> Settings -> Environment Variables):
# Example: https://movesmart-api.onrender.com OR https://api.movesmart.city
# VITE_API_BASE_URL=https://your-backend-domain.com


# ------------------------------------------------------------------------------
# 2. BACKEND CLOUD / PRODUCTION CONFIGURATION (Spring Boot Environment Variables)
# Configure these on Render, Railway, AWS ECS, or your Linux VM
# ------------------------------------------------------------------------------
# Active Spring Profile ('prod' enforces strict security, PostgreSQL, disables demo mock reset)
SPRING_PROFILES_ACTIVE=prod

# Cloud HTTP Port (Render/Railway/Heroku inject this automatically)
PORT=8080

# PostgreSQL Production Database (Standard JDBC format)
# Format: jdbc:postgresql://<host>:<port>/<database_name>
DATABASE_URL=jdbc:postgresql://your-db-host.com:5432/movesmart_db
DATABASE_USERNAME=movesmart_user
DATABASE_PASSWORD=your_strong_database_password

# Hibernate Schema Update Strategy (update = auto add tables/columns without dropping)
JPA_DDL_AUTO=update

# Strong HMAC-SHA256 JWT Signing Secret (Minimum 256 bits / 32 characters)
# Generate via: openssl rand -base64 48
JWT_SECRET=YourSuperSecretProductionJWTKeyWithAtLeast32Characters2026!
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins (Comma-separated origins that can access backend APIs)
# Must include your production Vercel frontend URL
CORS_ALLOWED_ORIGINS=https://movesmart.vercel.app,https://your-custom-domain.com

# Production Seeding & Demo Safety Controls
# When set to false, prevents mock/seed incidents from polluting real production databases
SEEDING_ENABLED=false
DEMO_RESET_ENABLED=false

# Bootstrap Initial Administrator Account (Only provisioned if user table is empty)
INITIAL_ADMIN_EMAIL=admin@movesmart.city
INITIAL_ADMIN_PASSWORD=ChangeThisStrongAdminPassword2026!

# Upload Directory for Photo Evidence (Local disk or mounted persistent volume)
UPLOAD_DIR=uploads
